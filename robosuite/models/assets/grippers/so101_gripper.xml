            <site group="1" name="gripperframe" pos="-0.0079 -0.000218121 -0.0981274" quat="0.707107 -0 0.707107 -2.37788e-17" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere"/>
            <!-- Link moving_jaw_so101_v1（活动颚） -->
            <body name="moving_jaw_so101_v1" pos="0.0202 0.0188 -0.0234" quat="0.707107 0.707107 -1.85362e-08 1.85362e-08">
